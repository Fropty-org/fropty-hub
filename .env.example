# .env.example — Fropty Hub
# Copie para .env.local e preencha. NUNCA commite .env.local (está no .gitignore).
# Em produção, as variáveis vivem nas Environment Variables da Vercel
# (Production / Preview / Development separados). Ver SECURITY.md §1 e §12.

# ── Supabase ─────────────────────────────────────────────────────────────────
# URL e anon key são PÚBLICAS por design (o modelo de segurança do Supabase
# depende de RLS, não de esconder a anon key). Podem ter prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>
# SEGREDO — ignora todo RLS. SÓ server-side. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>

# ── Stripe ───────────────────────────────────────────────────────────────────
# SEGREDOS — só server-side (app/lib/stripe.ts, webhook).
STRIPE_SECRET_KEY=<sua-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<seu-stripe-webhook-secret>

# ── FroptySentinel — verificação de reputação de URL (Service Desk) ──────────
# OPCIONAL, mas recomendado para cobertura forte. Chave da Google Safe Browsing
# v4 (malware + phishing + software indesejado). Grátis: crie um projeto em
# console.cloud.google.com, ative "Safe Browsing API" e gere uma API key.
# Sem esta chave, o Hub ainda checa phishing (phish.sinking.yachts) + existência
# do link (DNS/HTTP); com ela, a cobertura de malware fica muito mais robusta.
# SEGREDO — só server-side. NUNCA prefixar com NEXT_PUBLIC_.
GOOGLE_SAFE_BROWSING_KEY=<sua-google-safe-browsing-key>

# ── Resend (e-mail transacional) ─────────────────────────────────────────────
RESEND_API_KEY=<sua-resend-api-key>
RESEND_FROM_EMAIL="FroptyHub <noreply@fropty.com>"
CONTACT_EMAIL=contato@fropty.com

# ── Cron (Vercel) ────────────────────────────────────────────────────────────
# Bearer verificado em timing-safe nas rotas /api/cron/*. Use um valor aleatório longo.
CRON_SECRET=troque-por-um-segredo-aleatorio-longo

# ── URLs / hosts ─────────────────────────────────────────────────────────────
# Públicas (aparecem no bundle). Sem segredo — só endereços.
NEXT_PUBLIC_APP_URL=https://fropty.com
NEXT_PUBLIC_HUB_URL=https://hub.fropty.com
NEXT_PUBLIC_HUB_HOST=hub.fropty.com

# ── Testes E2E (Playwright) — só em .env.test.local, nunca em produção ────────
E2E_EMAIL=cliente-de-teste@exemplo.com
E2E_PASSWORD=senha-de-teste
